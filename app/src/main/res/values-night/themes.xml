<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark phone theme: a dark app theme also tells the page (prefers-color-scheme) to use its dark colours. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_bg</item>
        <item name="android:statusBarColor">@color/night_bg</item>
        <item name="android:navigationBarColor">@color/night_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
