# Line ends stay LF everywhere: the page's Content-Security-Policy carries its script's hash (tools/csp.js).
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
